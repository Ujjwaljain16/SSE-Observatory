{
  // Emits type declarations for the public core API only (src/core/index.ts and what it imports) into dist-cli/types.
  "extends": "./tsconfig.core.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist-cli/types"
  },
  "include": [],
  "files": ["src/core/index.ts"]
}
