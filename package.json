{
  "name": "sse-monitor",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ujjwaljain16/SSE-Observatory.git"
  },
  "bugs": {
    "url": "https://github.com/Ujjwaljain16/SSE-Observatory/issues"
  },
  "homepage": "https://github.com/Ujjwaljain16/SSE-Observatory#readme",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server.js\"",
    "dev:ui": "vite",
    "dev:server": "node server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run chaos\"",
    "chaos": "node test-servers/test-chaos-server.js",
    "simple": "node test-servers/simple-server.js",
    "build": "tsc -b && vite build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:soak": "playwright test e2e/soak.spec.ts",
    "test:all": "npm run test && npm run test:e2e",
    "test:ci": "concurrently \"npm run lint\" \"npm run typecheck\" && concurrently \"npm run test:coverage\" \"npm run test:e2e\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sentry/node": "^10.42.0",
    "@sentry/react": "^10.42.0",
    "@tanstack/react-virtual": "^3.13.21",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.563.0",
    "microdiff": "^1.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.1.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.17",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "msw": "^2.12.10",
    "postcss": "^8.4.32",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "vite": "^5.0.8",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.18",
    "vue": "^3.5.29"
  }
}