# ---- Proxy / backend (server.js and Vercel functions) ----
# In production the proxy is CLOSED by default: it only relays to hosts in ALLOWED_HOSTS.
# Comma-separated hostnames; "*.example.com" wildcards allowed.
ALLOWED_HOSTS=
# Set to 1 to let the proxy relay to any PUBLIC host (private/reserved addresses stay blocked).
PROXY_OPEN=
# Extra browser origins allowed to call the proxy (your own app origin is always allowed).
PROXY_ALLOWED_ORIGINS=
# Self-hosting inside a private network: allow private/reserved targets (use with care).
ALLOW_PRIVATE_TARGETS=
# Limits (defaults shown are for production; Vercel Hobby streams are capped at 55 s)
MAX_STREAM_SECONDS=
MAX_STREAM_MB=
MAX_CONCURRENT_STREAMS=
# Tagged proxy comments (: sse-proxy hb ...) and X-SSE-* diagnostic headers. On by default; set to 0 to turn them off.
PROXY_DIAGNOSTICS=
# Mock replay API is disabled in production unless this is 1 (optionally attach KV: KV_REST_API_URL/TOKEN)
ENABLE_MOCK_API=
# Express only
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=
RATE_LIMIT_MAX=
SENTRY_DSN=
# Client (build time)
VITE_SENTRY_DSN=
