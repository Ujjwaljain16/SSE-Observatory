{
  // Typechecks the code that must run without a DOM: the shared analysis core, the Node CLI and the fixture servers.
  // Compared with tsconfig.json there is no DOM lib, so `window`, `document`, `localStorage` and friends do not exist
  // here. fetch, TextDecoder, performance and AbortController come from @types/node.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/core", "src/cli", "src/fixtures"],
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
