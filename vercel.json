{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/sse/index.js": {
      "maxDuration": 60
    },
    "api/mock/stream.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|docs/|assets/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm ci --include=dev"
}
